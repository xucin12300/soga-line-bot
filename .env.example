# LINE Developers → 你的 Messaging API channel
#   Basic settings → Channel secret
LINE_CHANNEL_SECRET=
#   Messaging API → Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=
# flask soga 呼叫 GET /api/signups 時帶的 X-Api-Key。隨便產一串長的亂碼，
# 兩邊（這裡跟 flask_soga_web/.env 的 SOGA_LINE_BOT_API_KEY）填一樣的。
SOGA_LINE_BOT_API_KEY=
# 只理會這些群組（逗號分隔）。先留空，bot 進群組後從 log 抄 groupId 回來填。
LINE_ALLOWED_CHAT_IDS=
# 容器裡固定是 /data/line_bot.db；本機跑才需要改。
SOGA_LINE_BOT_DB_PATH=/data/line_bot.db
# SOGA 的 soga.db，讀 history_player_info.current_name 當玩家名單。容器裡固定是
# /soga-data/soga.db；本機跑可以指到 flask_soga_web/soga.db。
SOGA_PLAYERS_DB_PATH=/soga-data/soga.db
# 固定班底檔（每週自動帶入；每一行也是表上固定列出的時段）。容器裡是
# /app/weekly_defaults.txt，不設就用那份。
SOGA_WEEKLY_DEFAULTS_PATH=
# 一個時段最多幾個人。
SOGA_SLOT_CAPACITY=4
