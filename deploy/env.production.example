# LINE 登記 bot 在 NAS 上的正式環境設定。
#
# deploy/deploy.py 會把這份上傳成 NAS 上的 .env，docker-compose 同時拿它做
# 變數替換與容器環境。複製成 deploy/.env.production 再填（那份不進版控）。

# LINE Developers → Messaging API channel 的 Channel secret 與
# Channel access token (long-lived)。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# flask soga 讀 GET /api/signups 用的 key，跟 flask_soga_web/.env 的
# SOGA_LINE_BOT_API_KEY 一字不差。
SOGA_LINE_BOT_API_KEY=

# 只理會這些群組（逗號分隔 groupId）。第一次先留空，bot 進群組後從
# `docker logs soga-line-bot` 抄 groupId 回來填，再部署一次。
LINE_ALLOWED_CHAT_IDS=

# 容器埠口 publish 在哪個區網位址（flask soga 從計分電腦連 :12160）。
LINE_BOT_LAN_HOST=192.168.1.105

# 統計站在 NAS 上的資料目錄，裡面的 soga.db 是玩家名單的來源（唯讀掛載）。
SOGA_STATS_DATA_DIR=/volume1/homes/yc/soga-statistics/data

# 管理員的 LINE userId（逗號分隔），只有他們能「覆蓋」整張表。userId 從
# `docker logs soga-line-bot` 裡「user=U...」那段抄。
LINE_ADMIN_USER_IDS=

# 只能看表的群組（逗號分隔 groupId）：只回「名單」，其他指令都不理。
LINE_READONLY_CHAT_IDS=
